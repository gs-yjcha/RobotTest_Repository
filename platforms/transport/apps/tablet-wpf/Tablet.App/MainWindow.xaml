<Window x:Class="Tablet.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:Tablet.App.Views"
 Title="RobotTest Tablet · UI v10" Width="1440" Height="960" MinWidth="1024" MinHeight="700"
 WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
 FontFamily="Segoe UI, Malgun Gothic" FontSize="14" Foreground="{StaticResource Ink}"
 UseLayoutRounding="True" Stylus.IsPressAndHoldEnabled="False" Stylus.IsFlicksEnabled="False">
 <Window.Resources>
  <DataTemplate x:Key="Operate"><views:OperateView/></DataTemplate>
  <DataTemplate x:Key="Map"><views:MapEditView/></DataTemplate>
  <DataTemplate x:Key="Log"><views:LogView/></DataTemplate>
  <DataTemplate x:Key="Settings"><views:SettingsView DataContext="{Binding Settings}"/></DataTemplate>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#EEFFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="18,0">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="42" Height="42" Background="{StaticResource AccentGradient}" CornerRadius="13" Margin="0,0,12,0">
      <TextBlock Text="◈" Foreground="White" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <TextBlock Text="{Binding CurrentPage.Title}" FontSize="23" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,22,0"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Border Style="{StaticResource Chip}" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1">
      <StackPanel><TextBlock Text="{Binding RobotName}" FontWeight="Bold" FontSize="13"/><TextBlock Text="{Binding ModeText}" FontSize="11" Foreground="{StaticResource Ink2}"/></StackPanel>
     </Border>
     <Button Command="{Binding OpenSettingsCommand}" Margin="0,0,8,0" MinHeight="42" AutomationProperties.Name="MobED 연결 설정">
      <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{Binding LinkBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="{Binding LinkText}"/></StackPanel>
     </Button>
     <Border Style="{StaticResource Chip}"><StackPanel Orientation="Horizontal">
      <Grid Width="26" Height="26" Margin="0,0,6,0"><Ellipse Stroke="#E0E2FF" StrokeThickness="3"/><TextBlock Text="—" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Blue}"/></Grid>
      <StackPanel><TextBlock Text="위치 —" FontSize="12"/><TextBlock Text="미수신" FontSize="10" Foreground="{StaticResource Ink3}"/></StackPanel>
     </StackPanel></Border>
     <Border Style="{StaticResource Chip}"><StackPanel Orientation="Horizontal">
      <Grid Width="26" Height="26" Margin="0,0,6,0"><Ellipse Stroke="#E5E8F1" StrokeThickness="3"/><TextBlock Text="—" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
      <StackPanel><TextBlock Text="배터리 —" FontSize="12"/><TextBlock Text="미수신" FontSize="10" Foreground="{StaticResource Ink3}"/></StackPanel>
     </StackPanel></Border>
    </StackPanel>
    <Button Grid.Column="2" Style="{StaticResource StopButton}" Command="{Binding StopAllCommand}" Content="■  전체 정지" VerticalAlignment="Center"/>
   </Grid>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="108"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#BFFFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
    <DockPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="10,0,10,20"><TextBlock Text="ROBOT TEST" FontSize="10" Foreground="{StaticResource Ink3}" HorizontalAlignment="Center"/><TextBlock Text="UI v10" FontSize="11" Foreground="{StaticResource Blue}" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
     <ItemsControl ItemsSource="{Binding Pages}" Margin="0,12,0,0">
      <ItemsControl.ItemTemplate><DataTemplate>
       <Button Style="{StaticResource NavButton}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}">
        <StackPanel><TextBlock Text="{Binding Icon}" FontSize="25" HorizontalAlignment="Center"/><TextBlock Text="{Binding Title}" FontSize="13" Margin="0,7,0,0" HorizontalAlignment="Center"/></StackPanel>
       </Button>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </DockPanel>
   </Border>
   <ContentControl Grid.Column="1" Content="{Binding}" Margin="18">
    <ContentControl.Style><Style TargetType="ContentControl">
     <Setter Property="ContentTemplate" Value="{StaticResource Operate}"/>
     <Style.Triggers>
      <DataTrigger Binding="{Binding CurrentPage.Key}" Value="map"><Setter Property="ContentTemplate" Value="{StaticResource Map}"/></DataTrigger>
      <DataTrigger Binding="{Binding CurrentPage.Key}" Value="log"><Setter Property="ContentTemplate" Value="{StaticResource Log}"/></DataTrigger>
      <DataTrigger Binding="{Binding CurrentPage.Key}" Value="settings"><Setter Property="ContentTemplate" Value="{StaticResource Settings}"/></DataTrigger>
     </Style.Triggers>
    </Style></ContentControl.Style>
   </ContentControl>
  </Grid>
  <Border Grid.Row="2" Background="#EFF0FF" Padding="18,9" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
   <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Ink2}" FontSize="12"/>
  </Border>
 </Grid>
</Window>
