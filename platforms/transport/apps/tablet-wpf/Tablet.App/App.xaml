<Application x:Class="Tablet.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- 색상: UI 시안 v9 기준 -->
        <SolidColorBrush x:Key="Bg" Color="#EEF2F6"/>
        <SolidColorBrush x:Key="Panel" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Line" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Navy" Color="#0F172A"/>
        <SolidColorBrush x:Key="Ink" Color="#0F172A"/>
        <SolidColorBrush x:Key="Ink2" Color="#475569"/>
        <SolidColorBrush x:Key="Ink3" Color="#94A3B8"/>
        <SolidColorBrush x:Key="Blue" Color="#2563EB"/>
        <SolidColorBrush x:Key="Blue50" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="Red" Color="#DC2626"/>
        <SolidColorBrush x:Key="Green" Color="#16A34A"/>
        <SolidColorBrush x:Key="Amber" Color="#D97706"/>

        <!-- 상단 상태 칩 -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 왼쪽 메뉴 버튼 (터치 56px 이상) -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="84"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Foreground" Value="{StaticResource Ink2}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="12" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 전체 정지 -->
        <Style x:Key="StopButton" TargetType="Button">
            <Setter Property="Height" Value="56"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="{StaticResource Red}" Padding="20,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#991B1B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
