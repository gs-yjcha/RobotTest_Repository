<UserControl x:Class="Tablet.App.Views.OperateView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:Tablet.App.Views" Foreground="{StaticResource Ink}">
<Grid>
 <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
<Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True" Margin="0,0,16,0">
 <Grid>
  <views:SampleMap Margin="10,70,10,55"/>
  <Border VerticalAlignment="Top" Background="#F2FFFFFF" CornerRadius="14" Margin="16" Padding="14,10" BorderBrush="{StaticResource Line}" BorderThickness="1">
   <StackPanel><TextBlock Text="공장 1층 · 예시 지도" FontWeight="Bold"/><TextBlock Text="배치 확인용 · 실제 로봇 지도와 연결되지 않았습니다" FontSize="12" Foreground="{StaticResource Ink2}" Margin="0,3,0,0"/></StackPanel>
  </Border>
  <Border VerticalAlignment="Bottom" Background="#F2FFFFFF" CornerRadius="12" Margin="16" Padding="12,10">
   <WrapPanel><TextBlock Text="● 로봇 (예시)" Foreground="{StaticResource Blue}" Margin="0,0,18,0" FontSize="12"/><TextBlock Text="◎ 목적지" Margin="0,0,18,0" FontSize="12"/><TextBlock Text="▧ 주행 금지" Foreground="{StaticResource Red}" Margin="0,0,18,0" FontSize="12"/><TextBlock Text="▧ 감속" Foreground="{StaticResource Amber}" FontSize="12"/></WrapPanel>
  </Border>
 </Grid>
</Border>
 <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14">
  <TabControl SelectedIndex="{Binding OperateTab}">
   <TabItem Header="작업 지시">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="4,0,4,4">
      <Border Background="{StaticResource Blue50}" CornerRadius="16" Padding="16" Margin="0,0,0,18">
       <StackPanel><TextBlock Text="작업 대기" FontSize="22" FontWeight="Bold"/><TextBlock Text="목적지를 선택해 주세요" Foreground="{StaticResource Ink2}" Margin="0,6,0,0"/><TextBlock Text="대기  →  이동  →  도착  →  완료 승인" FontSize="11" Foreground="{StaticResource Blue}" Margin="0,14,0,0"/></StackPanel>
      </Border>
      <TextBlock Text="목적지" Style="{StaticResource Heading}"/>
      <ListBox ItemsSource="{Binding Destinations}" SelectedItem="{Binding SelectedDestination}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,18">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
         <Border x:Name="Destination" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="14,12"><ContentPresenter/></Border>
         <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Destination" Property="Background" Value="{StaticResource Blue50}"/><Setter TargetName="Destination" Property="BorderBrush" Value="{StaticResource Blue}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Destination" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
       </Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="Bold"/><TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource Ink2}" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Text="주행 설정" Style="{StaticResource Heading}"/>
      <TextBlock Text="주행 모드" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
      <ComboBox SelectedIndex="{Binding DriveModeIndex}" Margin="0,0,0,12" AutomationProperties.Name="주행 모드"><ComboBoxItem Content="회피"/><ComboBoxItem Content="정차"/></ComboBox>
      <TextBlock Text="속도 단계" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
      <ComboBox ItemsSource="{Binding SpeedOptions}" SelectedItem="{Binding Speed}" Margin="0,0,0,12" AutomationProperties.Name="속도 단계"/>
      <TextBlock Text="화면 선택만 반영됩니다. 실제 주행 설정은 연결 후 적용합니다." Style="{StaticResource Muted}" Margin="0,0,0,16"/>
      <TextBlock Text="{Binding SelectedDestination.Name, TargetNullValue=목적지 미선택}" FontWeight="Bold" Margin="0,0,0,8"/>
      <Button Content="선택한 목적지로 이동" Style="{StaticResource Primary}" IsEnabled="False" ToolTip="작업 상태 머신과 주행 명령 연결 후 사용할 수 있습니다."/>
      <UniformGrid Columns="3" Margin="0,8,0,0"><Button Content="일시정지" IsEnabled="False" Margin="0,0,4,0" FontSize="12"/><Button Content="재개" IsEnabled="False" Margin="2,0"/><Button Content="취소" IsEnabled="False" Margin="4,0,0,0"/></UniformGrid>
      <Button Content="도착 후 완료 승인" IsEnabled="False" Margin="0,8,0,0"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="위치 보정">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4,0,4,4">
     <TextBlock Text="현재 위치 보정" Style="{StaticResource Heading}"/>
     <TextBlock Text="위치 일치율" Style="{StaticResource Muted}"/>
     <TextBlock Text="— %" FontSize="38" FontWeight="Bold" Margin="0,8"/>
     <TextBlock Text="위치 상태 미수신" Style="{StaticResource Muted}" Margin="0,0,0,20"/>
     <TextBlock Text="보정 방법" Style="{StaticResource Heading}"/>
     <TabControl SelectedIndex="1">
      <TabItem Header="① 지도에서"><StackPanel><TextBlock Text="지도에서 위치와 방향을 지정합니다." Style="{StaticResource Muted}"/><TextBlock Text="실제 지도 수신 후 사용할 수 있습니다." Style="{StaticResource Muted}" Margin="0,12,0,20"/><Button Content="지도에서 지정" IsEnabled="False"/></StackPanel></TabItem>
      <TabItem Header="② 목적지에서"><StackPanel><TextBlock Text="등록 목적지의 위치로 보정합니다." Style="{StaticResource Muted}" Margin="0,0,0,12"/><ComboBox ItemsSource="{Binding Destinations}" DisplayMemberPath="Name" AutomationProperties.Name="위치 보정 목적지"/><TextBlock Text="현재 목록은 예시입니다." Style="{StaticResource Muted}" Margin="0,10,0,20"/></StackPanel></TabItem>
     </TabControl>
     <Button Content="위치 보정 적용" Style="{StaticResource Primary}" IsEnabled="False" Margin="0,20,0,0"/>
     <Button Content="현재 위치를 목적지로 등록" IsEnabled="False" Margin="0,10,0,0"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="수동 주행">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4,0,4,4">
     <Border Background="#FFF8EB" CornerRadius="14" Padding="14" Margin="0,0,0,18"><TextBlock Text="수동 주행 API 확인 후 사용할 수 있습니다." Foreground="{StaticResource Amber}"/></Border>
     <TextBlock Text="조작 모드" Style="{StaticResource Heading}"/>
     <ComboBox SelectedIndex="0" AutomationProperties.Name="수동 조작 모드"><ComboBoxItem Content="수동 주행"/><ComboBoxItem Content="지그재그"/><ComboBoxItem Content="프리스타일"/></ComboBox>
     <TextBlock Text="누르는 동안만 이동 · 손을 떼면 정지" Style="{StaticResource Muted}" Margin="0,14,0,8"/>
     <Viewbox Stretch="Uniform" MaxHeight="275"><Grid Width="290" Height="275" Margin="0,10">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
      <Button Grid.Column="1" IsEnabled="False" Margin="4"><TextBlock Text="▲&#10;전진" TextAlignment="Center" FontSize="14"/></Button>
      <Button Grid.Row="1" IsEnabled="False" Margin="4"><TextBlock Text="◀&#10;왼쪽" TextAlignment="Center" FontSize="14"/></Button>
      <Border Grid.Row="1" Grid.Column="1" CornerRadius="40" BorderBrush="{StaticResource Line}" BorderThickness="2" Margin="8"><TextBlock Text="누르는&#10;동안 이동" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="12" Foreground="{StaticResource Ink3}"/></Border>
      <Button Grid.Row="1" Grid.Column="2" IsEnabled="False" Margin="4"><TextBlock Text="▶&#10;오른쪽" TextAlignment="Center" FontSize="14"/></Button>
      <Button Grid.Row="2" Grid.Column="1" IsEnabled="False" Margin="4"><TextBlock Text="▼&#10;후진" TextAlignment="Center" FontSize="14"/></Button>
     </Grid></Viewbox>
     <TextBlock Text="수동 속도" Style="{StaticResource Muted}" Margin="0,12,0,5"/>
     <ComboBox SelectedIndex="0" AutomationProperties.Name="수동 속도"><ComboBoxItem Content="1단계"/><ComboBoxItem Content="2단계"/><ComboBoxItem Content="3단계"/></ComboBox>
     <TextBlock Text="현재 위치  X —  ·  Y —  ·  방향 —" Style="{StaticResource Muted}" Margin="0,18,0,0"/>
     <Button Content="현재 위치를 목적지로 등록" IsEnabled="False" Margin="0,16,0,0"/>
    </StackPanel></ScrollViewer>
   </TabItem>
  </TabControl>
 </Border>
</Grid>
</UserControl>
