<UserControl x:Class="Tablet.App.Views.LogView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:Tablet.App.Views" Foreground="{StaticResource Ink}">
<Grid>
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Border Style="{StaticResource Card}" Margin="0,0,0,16">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="현재 알람" Style="{StaticResource Heading}"/><TextBlock Text="로봇 알람 미수신" Foreground="{StaticResource Ink2}"/><TextBlock Text="알람 없음으로 판정한 상태가 아닙니다. 실제 알람 수신 기능은 아직 연결되지 않았습니다." Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
   <Border Grid.Column="1" Style="{StaticResource Chip}"><TextBlock Text="수신 대기" Foreground="{StaticResource Ink2}"/></Border>
  </Grid>
 </Border>
 <Border Grid.Row="1" Style="{StaticResource Card}">
  <DockPanel>
   <StackPanel DockPanel.Dock="Top"><TextBlock Text="작업·연결 이력" Style="{StaticResource Heading}"/><TextBlock Text="이번 실행의 앱 이벤트만 표시합니다. 영구 저장은 아직 연결되지 않았습니다." Style="{StaticResource Muted}" Margin="0,0,0,18"/></StackPanel>
   <ListView ItemsSource="{Binding Logs}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListView.ItemContainerStyle>
    <ListView.ItemTemplate><DataTemplate>
     <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="10,16"><Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="85"/><ColumnDefinition Width="95"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Time}" Foreground="{StaticResource Ink2}"/><TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="{StaticResource Blue}" FontWeight="Bold"/><TextBlock Grid.Column="2" Text="{Binding Message}"/>
     </Grid></Border>
    </DataTemplate></ListView.ItemTemplate>
   </ListView>
  </DockPanel>
 </Border>
</Grid>
</UserControl>
