<UserControl x:Class="Tablet.App.Views.MapEditView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:Tablet.App.Views" Foreground="{StaticResource Ink}">
<Grid>
 <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
<Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True" Margin="0,0,16,0">
 <Grid>
  <views:SampleMap Margin="10,70,10,55"/>
  <Border VerticalAlignment="Top" Background="#F2FFFFFF" CornerRadius="14" Margin="16" Padding="14,10" BorderBrush="{StaticResource Line}" BorderThickness="1">
   <StackPanel><TextBlock Text="공장 1층 · 예시 지도" FontWeight="Bold"/><TextBlock Text="배치 확인용 · 실제 로봇 지도와 연결되지 않았습니다" FontSize="12" Foreground="{StaticResource Ink2}" Margin="0,3,0,0"/></StackPanel>
  </Border>
  <Border VerticalAlignment="Bottom" Background="#F2FFFFFF" CornerRadius="12" Margin="16" Padding="12,10">
   <WrapPanel><TextBlock Text="● 로봇 (예시)" Foreground="{StaticResource Blue}" Margin="0,0,18,0" FontSize="12"/><TextBlock Text="◎ 목적지" Margin="0,0,18,0" FontSize="12"/><TextBlock Text="▧ 주행 금지" Foreground="{StaticResource Red}" Margin="0,0,18,0" FontSize="12"/><TextBlock Text="▧ 감속" Foreground="{StaticResource Amber}" FontSize="12"/></WrapPanel>
  </Border>
 </Grid>
</Border>
 <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16">
  <TabControl>
   <TabItem Header="목적지"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="등록 목적지" Style="{StaticResource Heading}"/>
    <ItemsControl ItemsSource="{Binding Destinations}"><ItemsControl.ItemTemplate><DataTemplate>
     <Border Background="#F7F8FC" CornerRadius="14" Padding="14" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="Bold"/><TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel></Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Button Content="목적지 추가" IsEnabled="False" Margin="0,14,0,0"/>
    <Button Content="이름 변경 / 삭제" IsEnabled="False" Margin="0,8,0,0"/>
    <TextBlock Text="예시 목록입니다. 로봇의 실제 목적지는 연결 후 표시됩니다." Style="{StaticResource Muted}" Margin="0,16,0,0"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="영역"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="영역 편집" Style="{StaticResource Heading}"/>
    <UniformGrid Columns="2"><Button Content="주행 금지" IsEnabled="False" Margin="3"/><Button Content="가상 벽" IsEnabled="False" Margin="3"/><Button Content="감속 구역" IsEnabled="False" Margin="3"/><Button Content="경사 구역" IsEnabled="False" Margin="3"/></UniformGrid>
    <TextBlock Text="로봇의 영역 API 지원 범위를 확인한 뒤 편집 기능을 연결합니다." Style="{StaticResource Muted}" Margin="0,18,0,0"/>
    <Button Content="로봇에 반영" Style="{StaticResource Primary}" IsEnabled="False" Margin="0,20,0,0"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="맵 이미지"><StackPanel><TextBlock Text="맵 이미지" Style="{StaticResource Heading}"/><TextBlock Text="현재는 예시 지도를 표시합니다. 실제 지도 수신·이미지 편집은 이후 연결합니다." Style="{StaticResource Muted}"/><Button Content="맵 불러오기" IsEnabled="False" Margin="0,20,0,0"/><Button Content="변경 사항 저장" IsEnabled="False" Margin="0,8,0,0"/></StackPanel></TabItem>
  </TabControl>
 </Border>
</Grid>
</UserControl>
