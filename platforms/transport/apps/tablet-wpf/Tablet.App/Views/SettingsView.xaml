<UserControl x:Class="Tablet.App.Views.SettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:Tablet.App.Views" Foreground="{StaticResource Ink}">
<Grid>
 <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
 <Border Style="{StaticResource Card}" Margin="0,0,16,0">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0">
   <TextBlock Text="로봇 연결 (MobED)" Style="{StaticResource Heading}"/>
   <TextBlock Text="태블릿에서 MobED에 직접 연결합니다." Style="{StaticResource Muted}" Margin="0,0,0,22"/>
   <TextBlock Text="접속 주소" FontWeight="Bold" Margin="0,0,0,8"/>
   <TextBox Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="MobED 접속 주소"/>
   <TextBlock Text="주소와 포트는 장비에서 확인한 값을 사용합니다." Style="{StaticResource Muted}" Margin="0,7,0,22"/>
   <TextBlock Text="인증서 폴더" FontWeight="Bold" Margin="0,0,0,8"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox Text="{Binding CertificateFolder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="인증서 폴더 경로"/>
    <Button Grid.Column="1" Content="폴더 선택" IsEnabled="False" Margin="8,0,0,0"/>
   </Grid>
   <TextBlock Text="폴더 안 인증서 파일" FontWeight="Bold" Margin="0,22,0,8"/>
   <ComboBox IsEnabled="False" AutomationProperties.Name="인증서 파일"><ComboBoxItem Content="폴더 선택 기능 연결 후 표시됩니다" IsSelected="True"/></ComboBox>
   <TextBlock Text="API Key" FontWeight="Bold" Margin="0,22,0,8"/>
   <PasswordBox MinHeight="48" Padding="12,10" Background="#F7F8FC" BorderBrush="{StaticResource Line}" AutomationProperties.Name="MobED API Key"/>
   <TextBlock Text="현재 입력은 화면 확인용이며 저장하거나 전송하지 않습니다." Style="{StaticResource Muted}" Margin="0,8,0,20"/>
   <Button Content="저장 후 연결 시험" Style="{StaticResource Primary}" IsEnabled="False"/>
   <TextBlock Text="설정 저장·Key 암호화·인증서 선택은 T3에서 연결합니다." Style="{StaticResource Muted}" Margin="0,10,0,0"/>
  </StackPanel></ScrollViewer>
 </Border>
 <Border Grid.Column="1" Style="{StaticResource Card}">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="MobED 연결 시험" Style="{StaticResource Heading}"/>
   <Border Background="{StaticResource Blue50}" CornerRadius="13" Padding="12" Margin="0,0,0,18"><TextBlock Text="시험 대기 · 실제 연결 검사는 아직 실행되지 않았습니다." Foreground="{StaticResource Blue}"/></Border>
   <Border Background="#F7F8FC" CornerRadius="13" Padding="14,16" Margin="0,0,0,8"><TextBlock Text="①  접속 주소 응답"/></Border>
   <Border Background="#F7F8FC" CornerRadius="13" Padding="14,16" Margin="0,0,0,8"><TextBlock Text="②  TLS 인증서 확인"/></Border>
   <Border Background="#F7F8FC" CornerRadius="13" Padding="14,16" Margin="0,0,0,8"><TextBlock Text="③  인증 확인"/></Border>
   <Border Background="#F7F8FC" CornerRadius="13" Padding="14,16" Margin="0,0,0,8"><TextBlock Text="④  서버 API 판본"/></Border>
   <Border Background="#F7F8FC" CornerRadius="13" Padding="14,16" Margin="0,0,0,8"><TextBlock Text="⑤  주행 가능 상태"/></Border>
   <Border Background="#F7F8FC" CornerRadius="13" Padding="14,16" Margin="0,0,0,8"><TextBlock Text="⑥  맵·위치 상태"/></Border>
   <TextBlock Text="화면 구성 단계입니다. Mock 연결 표시는 위 6단계 실기 시험 통과를 뜻하지 않습니다." Style="{StaticResource Muted}" Margin="0,14,0,0"/>
  </StackPanel></ScrollViewer>
 </Border>
</Grid>
</UserControl>
