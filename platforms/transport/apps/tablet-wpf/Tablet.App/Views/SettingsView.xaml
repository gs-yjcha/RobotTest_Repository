<UserControl x:Class="Tablet.App.Views.SettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Foreground="{StaticResource Ink}">
<Grid>
 <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
 <Border Style="{StaticResource Card}" Margin="0,0,16,0">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding CanEdit}" Margin="0,0,8,0">
   <TextBlock Text="로봇 연결 (MobED)" Style="{StaticResource Heading}"/>
   <TextBlock Text="태블릿에서 MobED에 직접 연결합니다." Style="{StaticResource Muted}" Margin="0,0,0,22"/>
   <TextBlock Text="접속 주소" FontWeight="Bold" Margin="0,0,0,8"/>
   <TextBox Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="MobED 접속 주소"/>
   <TextBlock Text="주소와 포트는 장비에서 확인한 값을 사용합니다." Style="{StaticResource Muted}" Margin="0,7,0,22"/>
   <TextBlock Text="인증서 폴더" FontWeight="Bold" Margin="0,0,0,8"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox x:Name="CertificateFolderInput" Text="{Binding CertificateFolder, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="인증서 폴더 경로"/>
    <Button Grid.Column="1" Content="폴더 선택" Click="SelectCertificateFolder" Margin="8,0,0,0"/>
   </Grid>
   <TextBlock Text="폴더 안 인증서 파일" FontWeight="Bold" Margin="0,22,0,8"/>
   <ComboBox ItemsSource="{Binding Certificates}" SelectedItem="{Binding SelectedCertificate}"
             AutomationProperties.Name="인증서 파일">
    <ComboBox.ItemTemplate>
     <DataTemplate>
      <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap">
       <TextBlock.Style>
        <Style TargetType="TextBlock">
         <Style.Triggers>
          <DataTrigger Binding="{Binding IsExpired}" Value="True">
           <Setter Property="Foreground" Value="Firebrick"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </TextBlock.Style>
      </TextBlock>
     </DataTemplate>
    </ComboBox.ItemTemplate>
   </ComboBox>
   <TextBlock Text="{Binding CertificateMessage}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/>
   <TextBlock Text="API Key" FontWeight="Bold" Margin="0,22,0,8"/>
   <TextBlock Text="{Binding KeyPreview}" Margin="0,0,0,8"/>
   <PasswordBox x:Name="ApiKeyInput" MinHeight="48" Padding="12,10" Background="#F7F8FC" BorderBrush="{StaticResource Line}" AutomationProperties.Name="MobED API Key"/>
   <TextBlock Text="키를 등록하거나 변경할 때만 입력하세요. 저장한 키는 현재 Windows 계정으로 암호화됩니다."
              Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,20"/>
   <Button Content="{Binding SaveButtonText}" Style="{StaticResource Primary}" Click="SaveAndTest"/>
  </StackPanel></ScrollViewer>
 </Border>
 <Border Grid.Column="1" Style="{StaticResource Card}">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="MobED 연결 시험" Style="{StaticResource Heading}"/>
   <Border Background="{StaticResource Blue50}" CornerRadius="13" Padding="12" Margin="0,0,0,18">
    <TextBlock Text="{Binding ResultMessage}" TextWrapping="Wrap" Foreground="{StaticResource Blue}"
               AutomationProperties.LiveSetting="Polite"/>
   </Border>
   <ItemsControl ItemsSource="{Binding Steps}">
    <ItemsControl.ItemTemplate>
     <DataTemplate>
      <Border Background="#F7F8FC" CornerRadius="13" Padding="14,12" Margin="0,0,0,8">
       <StackPanel>
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,4,0,0">
         <TextBlock.Style>
          <Style TargetType="TextBlock">
           <Setter Property="Foreground" Value="{StaticResource Ink2}"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Passed">
             <Setter Property="Foreground" Value="DarkGreen"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Failed">
             <Setter Property="Foreground" Value="Firebrick"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Checking">
             <Setter Property="Foreground" Value="{StaticResource Blue}"/>
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </TextBlock.Style>
        </TextBlock>
       </StackPanel>
      </Border>
     </DataTemplate>
    </ItemsControl.ItemTemplate>
   </ItemsControl>
   <TextBlock Text="{Binding TestScope}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0"/>
  </StackPanel></ScrollViewer>
 </Border>
</Grid>
</UserControl>
